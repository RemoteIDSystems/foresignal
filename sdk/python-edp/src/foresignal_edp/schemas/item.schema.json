{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresignal.ai/protocol/edp-1.0/item.schema.json",
  "title": "Foresignal EDP 1.0 item",
  "description": "One EDP item (one variant per type)",
  "oneOf": [
    {
      "$ref": "#/$defs/EdpFeatureItem"
    },
    {
      "$ref": "#/$defs/EdpEventItem"
    },
    {
      "$ref": "#/$defs/EdpObservationItem"
    },
    {
      "$ref": "#/$defs/EdpDocumentItem"
    },
    {
      "$ref": "#/$defs/EdpForecastItem"
    },
    {
      "$ref": "#/$defs/EdpDeleteItem"
    },
    {
      "$ref": "#/$defs/EdpStatusItem"
    }
  ],
  "$defs": {
    "EdpDeleteItem": {
      "type": "object",
      "description": "Tombstone for {stream}:{id}; observedAt and properties are optional (kept for audit)",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "delete"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Item properties, validated against the stream's payloadSchema"
        }
      },
      "required": [
        "stream",
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    "EdpDocumentItem": {
      "type": "object",
      "description": "A text item: post, article, report, transcript or note",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "document"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Item properties, validated against the stream's payloadSchema"
        },
        "documentType": {
          "type": "string",
          "enum": [
            "social-post",
            "article",
            "report",
            "transcript",
            "note"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "handle": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "accountId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "publishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Foresignal object references or URLs"
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "thumbUrl": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "url"
            ]
          }
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpGeometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "engagement": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpOrigin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "type",
        "id",
        "documentType",
        "text"
      ],
      "additionalProperties": true
    },
    "EdpEventItem": {
      "type": "object",
      "description": "A discrete occurrence",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "event"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Item properties, validated against the stream's payloadSchema"
        },
        "eventTime": {
          "type": "string",
          "format": "date-time"
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpGeometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "upstreamEventId": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpOrigin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "type",
        "id",
        "eventTime"
      ],
      "additionalProperties": true
    },
    "EdpFeatureItem": {
      "type": "object",
      "description": "Current state of an entity (layer streams)",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "feature"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Item properties, validated against the stream's payloadSchema"
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpGeometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventTime": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "validUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpOrigin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    "EdpForecastItem": {
      "type": "object",
      "description": "A probability or quantiles (monotonic: p05 ≤ p10 ≤ p25 ≤ p50 ≤ p75 ≤ p90 ≤ p95, checked by the server) for a question",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "forecast"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Item properties, validated against the stream's payloadSchema"
        },
        "question": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "externalId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "closeTime": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "resolutionCriteria": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "externalId",
            "title"
          ]
        },
        "questionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "quantiles": {
          "oneOf": [
            {
              "$ref": "#/$defs/Quantiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "madeAt": {
          "type": "string",
          "format": "date-time",
          "description": "Provider-claimed time; the recorded made_at is max(madeAt, receipt time)"
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpOrigin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "type",
        "id",
        "madeAt"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "probability"
              ],
              "properties": {
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "required": [
                "quantiles"
              ],
              "properties": {
                "quantiles": {
                  "$ref": "#/$defs/Quantiles"
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "object"
                }
              }
            },
            {
              "required": [
                "questionRef"
              ],
              "properties": {
                "questionRef": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "EdpGeometry": {
      "type": "object",
      "description": "GeoJSON geometry (RFC 7946, WGS84 lon/lat, optional altitude in metres). GeometryCollection is not accepted. The server also checks bounds, ring closure, vertex count (≤ 10,000) and that the type matches the stream's declared geometry.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "EdpObservationItem": {
      "type": "object",
      "description": "A value of a series",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "observation"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Item properties, validated against the stream's payloadSchema"
        },
        "seriesKey": {
          "type": "string",
          "maxLength": 128
        },
        "t": {
          "type": "string",
          "description": "Period or instant: YYYY, YYYY-Qn, YYYY-MM, YYYY-Www (ISO week), YYYY-MM-DD, or an RFC 3339 timestamp with offset. Periods are UTC intervals [start, end); one series uses one granularity.",
          "pattern": "^([0-9]{4}|[0-9]{4}-Q[1-4]|[0-9]{4}-(0[1-9]|1[0-2])|[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])|[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2}))$"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "knownAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Provider-claimed availability time; stored as given. Foresignal uses max(knownAt, its own receipt time) for as-of and look-ahead rules."
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdpOrigin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "type",
        "id",
        "seriesKey",
        "t",
        "value"
      ],
      "additionalProperties": true
    },
    "EdpOrigin": {
      "type": "object",
      "description": "Item-level provenance: who originally observed or published this item, when it differs from the manifest originator (for evidence independence)",
      "properties": {
        "originator": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "sensor-network",
            "agency",
            "aggregator",
            "media",
            "crowd",
            "social",
            "operator",
            "derived",
            null
          ]
        },
        "upstreamId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The original publisher's id for the observation or report"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other items (stream:id) or upstream ids this item was derived from"
        }
      },
      "required": [
        "originator"
      ]
    },
    "EdpStatusItem": {
      "type": "object",
      "description": "Provider health (no record). Without stream it is the source's health; with stream, that stream's health.",
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "type": {
          "type": "string",
          "const": "status"
        },
        "health": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "blocked",
            "layout-changed",
            "geo-restricted"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "health"
      ]
    },
    "Quantiles": {
      "type": "object",
      "properties": {
        "p05": {
          "type": "number"
        },
        "p10": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        }
      },
      "required": [
        "p05",
        "p25",
        "p50",
        "p75",
        "p95"
      ]
    }
  }
}
