{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresignal.ai/protocol/edp-1.0/event.schema.json",
  "title": "Foresignal EDP 1.0 event",
  "type": "object",
  "description": "A discrete occurrence",
  "properties": {
    "stream": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "type": {
      "type": "string",
      "const": "event"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Item properties, validated against the stream's payloadSchema"
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "description": "GeoJSON geometry (WGS84, lon/lat)"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstreamEventId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "stream",
    "type",
    "id",
    "eventTime"
  ],
  "additionalProperties": true
}
