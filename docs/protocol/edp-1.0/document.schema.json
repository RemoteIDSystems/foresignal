{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresignal.ai/protocol/edp-1.0/document.schema.json",
  "title": "Foresignal EDP 1.0 document",
  "type": "object",
  "description": "A text item: post, article, report, transcript or note",
  "properties": {
    "stream": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "type": {
      "type": "string",
      "const": "document"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Item properties, validated against the stream's payloadSchema"
    },
    "documentType": {
      "type": "string",
      "enum": [
        "social-post",
        "article",
        "report",
        "transcript",
        "note"
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "about": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foresignal object references or URLs"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "thumbUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/EdpGeometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "engagement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "origin": {
      "oneOf": [
        {
          "$ref": "#/$defs/EdpOrigin"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stream",
    "type",
    "id",
    "documentType",
    "text"
  ],
  "additionalProperties": true,
  "$defs": {
    "EdpGeometry": {
      "type": "object",
      "description": "GeoJSON geometry (RFC 7946, WGS84 lon/lat, optional altitude in metres). GeometryCollection is not accepted. The server also checks bounds, ring closure, vertex count (≤ 10,000) and that the type matches the stream's declared geometry.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "EdpOrigin": {
      "type": "object",
      "description": "Item-level provenance: who originally observed or published this item, when it differs from the manifest originator (for evidence independence)",
      "properties": {
        "originator": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "sensor-network",
            "agency",
            "aggregator",
            "media",
            "crowd",
            "social",
            "operator",
            "derived",
            null
          ]
        },
        "upstreamId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The original publisher's id for the observation or report"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other items (stream:id) or upstream ids this item was derived from"
        }
      },
      "required": [
        "originator"
      ]
    }
  }
}
