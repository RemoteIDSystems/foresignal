{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foresignal.ai/protocol/edp-1.0/event.schema.json",
  "title": "Foresignal EDP 1.0 event",
  "type": "object",
  "description": "A discrete occurrence",
  "properties": {
    "stream": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "type": {
      "type": "string",
      "const": "event"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Item properties, validated against the stream's payloadSchema"
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/EdpGeometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstreamEventId": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "oneOf": [
        {
          "$ref": "#/$defs/EdpOrigin"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stream",
    "type",
    "id",
    "eventTime"
  ],
  "additionalProperties": true,
  "$defs": {
    "EdpGeometry": {
      "type": "object",
      "description": "GeoJSON geometry (RFC 7946, WGS84 lon/lat, optional altitude in metres). GeometryCollection is not accepted. The server also checks bounds, ring closure, vertex count (≤ 10,000) and that the type matches the stream's declared geometry.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "EdpOrigin": {
      "type": "object",
      "description": "Item-level provenance: who originally observed or published this item, when it differs from the manifest originator (for evidence independence)",
      "properties": {
        "originator": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "sensor-network",
            "agency",
            "aggregator",
            "media",
            "crowd",
            "social",
            "operator",
            "derived",
            null
          ]
        },
        "upstreamId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The original publisher's id for the observation or report"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other items (stream:id) or upstream ids this item was derived from"
        }
      },
      "required": [
        "originator"
      ]
    }
  }
}
