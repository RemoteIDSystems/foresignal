     "params": {}},
    {"id": "line-substation", "enabled": true, "method": "topological", "label": "likely", "relation": "transmits_power",
     "params": {"withinMeters": 50}},
    {"id": "plant-substation", "enabled": true, "method": "proximity", "label": "possible", "relation": "supplies_power",
     "params": {"maxKm": 5, "capacityFactorKm": 2}},
    {"id": "substation-critical-load", "enabled": true, "method": "proximity", "label": "possible", "relation": "supplies_power",
     "params": {"urbanKm": 3, "ruralKm": 10, "populationUrban": 100000}},
    {"id": "airport-port-serves", "enabled": true, "method": "inferred", "label": "likely", "relation": "serves",
     "params": {}}
  ]
