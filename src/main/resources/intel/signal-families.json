{
  "version": "1.0.0",
  "description": "Signal families (prompt 119, Intelligence-Design \u00a75.4): the one registry that maps a source, record kind, intelligence event type, finding type or alert/anomaly rule tag to a signal family. Rules are tried in order and the first whose every match key equals the input wins; operator rows from the setting intel.signalFamilies (same shape) are tried first. Aliases are names earlier prompts stored (101's intel_event_member.signal_family); they resolve to the canonical family and are never rewritten in stored rows.",
  "families": [
    {
      "id": "ais-behaviour",
      "label": "Vessel behavior (AIS gaps, loitering, rendezvous, chokepoint activity)",
      "aliases": []
    },
    {
      "id": "aviation-military",
      "label": "Military aviation activity",
      "aliases": []
    },
    {
      "id": "aviation-ops",
      "label": "Civil aviation operations and restrictions (delays, ground stops, NOTAMs, emergency squawks)",
      "aliases": [
        "aviation-behaviour",
        "aviation-restriction"
      ]
    },
    {
      "id": "conflict",
      "label": "Armed conflict and unrest events",
      "aliases": []
    },
    {
      "id": "outage",
      "label": "Power and service outages",
      "aliases": [
        "grid-frequency"
      ]
    },
    {
      "id": "internet-measurement",
      "label": "Internet measurement (outages, BGP)",
      "aliases": []
    },
    {
      "id": "gnss-interference",
      "label": "GNSS jamming and spoofing",
      "aliases": []
    },
    {
      "id": "nav-warning",
      "label": "Navigational and maritime warnings",
      "aliases": []
    },
    {
      "id": "attention",
      "label": "Public attention and coverage (pageviews, article volume and tone)",
      "aliases": []
    },
    {
      "id": "seismic",
      "label": "Earthquakes and tsunamis",
      "aliases": []
    },
    {
      "id": "fire",
      "label": "Fires and fire detections",
      "aliases": []
    },
    {
      "id": "weather-severe",
      "label": "Severe weather, storms and floods",
      "aliases": [
        "weather-hazard"
      ]
    },
    {
      "id": "cyber",
      "label": "Cyber threats and vulnerabilities",
      "aliases": []
    },
    {
      "id": "markets",
      "label": "Market prices, volumes and positioning",
      "aliases": []
    },
    {
      "id": "sanctions",
      "label": "Sanctions and filings",
      "aliases": []
    },
    {
      "id": "health",
      "label": "Disease outbreaks and public health",
      "aliases": []
    },
    {
      "id": "space",
      "label": "Space weather, launches and reentries",
      "aliases": []
    }
