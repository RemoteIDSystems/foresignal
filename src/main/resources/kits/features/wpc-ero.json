[
  {
    "id": "wpc-ero-d1",
    "name": "WPC Excessive Rainfall Outlook Day 1",
    "description": "NOAA Weather Prediction Center Excessive Rainfall Outlook for Day 1 (08-16z, 16z and 08z issuances), as categorical polygons: dn 1 Marginal (at least 5%), 2 Slight (15%), 3 Moderate (40%), 4 High (70%). One polygon per category per day; observedAt is the issue time and the valid range is start_time..end_time. A category that disappears from the layer is tombstoned.",
    "kind": "rainfall-outlook",
    "protocol": "arcgis",
    "url": "https://mapservices.weather.noaa.gov/vector/rest/services/hazards/wpc_precip_hazards/MapServer/0",
    "idField": "category",
    "titleField": "outlook",
    "fields": {
      "dn": { "target": "category", "type": "string", "valueMap": { "1": "MRGL", "2": "SLGT", "3": "MDT", "4": "HIGH" } },
      "outlook": { "target": "outlook", "type": "string" },
      "product": { "target": "product", "type": "string" },
      "issue_time": { "target": "issueTime", "type": "timestamp" },
      "start_time": { "target": "startTime", "type": "timestamp" },
      "end_time": { "target": "endTime", "type": "timestamp" }
    },
    "time": { "observedAt": "issueTime", "validFrom": "startTime", "validUntil": "endTime", "format": "auto", "zone": "UTC" },
    "query": { "where": "1=1" },
    "interval": "30m",
    "minInterval": "30m",
    "budget": { "perMinute": 5, "perDay": 300 },
    "absenceTombstones": true,
    "zeroResultsNormal": true,
    "searchFields": ["category", "outlook"],
    "tileProperties": ["category", "outlook"],
    "retention": "90d",
