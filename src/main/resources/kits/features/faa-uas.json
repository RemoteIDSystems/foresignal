[
  {
    "id": "faa-uas-nsufr",
    "name": "FAA National Security UAS Flight Restrictions",
    "description": "Permanent national security UAS flight restrictions (14 CFR 99.7 special security instructions) over military, energy and other critical facilities, from the FAA layer DoD_Mar_13 (layer 0, National_Security_UAS_Flight_Restrictions). Floor 'Surface' is 0 ft; the AGL ceilings are read from text such as \"400' AGL\" (the 57 ceilings given as \"2,000' MSL\" on 2026-10-14 carry no ceilingFt). The layer has no GlobalID and FAA_ID repeats for 10 of 2,284 rows, so the id is OBJECTID, which a republication may renumber. A restriction missing from two consecutive complete fetches is tombstoned.",
    "kind": "uas-restriction",
    "protocol": "arcgis",
    "url": "https://services6.arcgis.com/ssFJjBXIUyZDrSYZ/ArcGIS/rest/services/DoD_Mar_13/FeatureServer/0",
    "idField": "objectId",
    "titleField": "name",
    "fields": {
      "OBJECTID": {
        "target": "objectId",
        "type": "integer"
      },
      "Base": {
        "target": "name",
        "type": "string"
      },
      "Facility": {
        "target": "facility",
        "type": "string"
      },
      "Reason": {
        "target": "reason",
        "type": "string"
      },
      "State": {
        "target": "state",
        "type": "string"
      },
      "Floor": {
        "target": "floorFt",
        "type": "number",
        "unit": "[ft_i]",
        "valueMap": {
          "Surface": 0
        }
      },
      "Ceiling": {
        "target": "ceilingFt",
        "type": "number",
        "unit": "[ft_i]",
        "valueMap": {
          "400' AGL": 400,
          "2,000' AGL": 2000,
          "2,500' AGL": 2500,
          "6,500' AGL": 6500,
          "8,000' AGL": 8000
        }
      }
    },
    "constants": {
      "restrictionType": "national-security"
    },
    "time": {
      "observedAt": "RECEIVED"
    },
    "interval": "24h",
    "minInterval": "1h",
    "budget": {
      "perMinute": 10,
      "perDay": 100
    },
    "paging": {
      "pageSize": 1000,
      "maxPages": 10
    },
    "absenceTombstones": true,
    "zeroResultsNormal": false,
    "searchFields": [
      "name",
      "facility",
      "state"
    ],
    "tileProperties": [
      "restrictionType",
      "name",
      "ceilingFt"
    ],
    "retention": "90d",
    "license": "US-PD",
    "attribution": "Federal Aviation Administration",
    "homepage": "https://udds-faa.opendata.arcgis.com",
    "termsUrl": "https://www.faa.gov/web_policies"
  },
